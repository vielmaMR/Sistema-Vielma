# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio.

# Clave secreta de Flask (usada para firmar sesiones y CSRF).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# Entorno: development o production
FLASK_ENV=development

# Duración de la sesión persistente (en días)
SESSION_LIFETIME_DAYS=30

# Marca las cookies como Secure (solo HTTPS). Usar true en producción.
SESSION_COOKIE_SECURE=false

# Zona horaria del taller
TIMEZONE=America/Asuncion

# Contraseñas iniciales de los usuarios semilla.
# Si se dejan vacías, se usa "cambiar123" y se obliga a cambiarla al primer login.
SEED_PASSWORD_CHRISTIAN=
SEED_PASSWORD_HUMBERTO=
SEED_PASSWORD_ARTURO=
